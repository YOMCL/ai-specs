## Testing Standards

### Cypress E2E Tests (b2b)

Use `data-testid` attributes for all element selection — never CSS classes or text content:

```typescript
// cypress/e2e/banners.cy.ts
describe('Banner Management', () => {
  beforeEach(() => {
    cy.intercept('GET', '/api/v3/customers/*/banners', { fixture: 'banners.json' }).as('getBanners');
    cy.visit('/banners');
  });

  it('should display the banner list', () => {
    cy.wait('@getBanners');
    cy.get('[data-testid="banner-card"]').should('have.length.greaterThan', 0);
  });

  it('should create a new banner', () => {
    cy.intercept('POST', '/api/v3/banners', { statusCode: 201, body: { id: '1' } }).as('createBanner');

    cy.get('[data-testid="create-banner-button"]').click();
    cy.get('[data-testid="banner-title-input"]').type('Summer Sale');
    cy.get('[data-testid="submit-button"]').click();

    cy.wait('@createBanner');
    cy.get('[data-testid="success-alert"]').should('be.visible');
  });

  it('should show validation errors for empty form', () => {
    cy.get('[data-testid="create-banner-button"]').click();
    cy.get('[data-testid="submit-button"]').click();
    cy.get('[data-testid="title-error"]').should('contain', 'Title is required');
  });
});
```

### Component Tests (React Testing Library)

```typescript
import { render, screen, fireEvent } from '@testing-library/react';

describe('BannerCard', () => {
  it('should call onEdit when edit button is clicked', () => {
    const onEdit = jest.fn();
    const banner = createMockBanner({ id: '1', title: 'Summer Sale' });

    render(<BannerCard banner={banner} onEdit={onEdit} />);
    fireEvent.click(screen.getByRole('button', { name: /edit/i }));

    expect(onEdit).toHaveBeenCalledWith(banner);
  });

  it('should render banner title', () => {
    const banner = createMockBanner({ title: 'Summer Sale' });
    render(<BannerCard banner={banner} onEdit={jest.fn()} />);
    expect(screen.getByText('Summer Sale')).toBeInTheDocument();
  });
});
```

### Test Organization
- Group by feature: `banners.cy.ts`, `customers.cy.ts`
- Test user workflows, not implementation details
- Never use `cy.wait(ms)` for timing — use `cy.intercept` + `cy.wait('@alias')`
- Mock SWR fetchers in unit tests — do not make real HTTP calls

