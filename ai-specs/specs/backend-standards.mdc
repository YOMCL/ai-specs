## Authentication & Authorization

YOM uses `@yomcl/jwt-verify` for authentication. Do not use `@nestjs/jwt` or Passport directly in YOM services.

### Guards

| Guard | Purpose |
|-------|---------|
| `AdminGuard` | Requires a valid admin JWT — for internal admin operations |
| `ReadGuard` | Requires a valid JWT with read permissions |
| `StoreGuard` | Requires a valid store-scoped JWT — for store-facing endpoints |

### Usage

```typescript
import { AdminGuard, ReadGuard, StoreGuard } from '@yomcl/jwt-verify';

// Admin-only endpoint
@Controller('banners')
@UseGuards(AdminGuard)
export class BannerAdminController {
  @Post()
  @HttpCode(201)
  async create(@Body() dto: CreateBannerDto): Promise<CreateBannerResponseDto> {
    return this.bannerService.create(dto);
  }
}

// Read endpoint accessible with any valid token
@Controller('banners')
@UseGuards(ReadGuard)
export class BannerController {
  @Get()
  async findAll(@Request() req): Promise<BannerResponseDto[]> {
    const { customerId } = req.user; // customerId always comes from the JWT
    return this.bannerService.findAll(customerId);
  }
}

// Store-facing endpoint
@Controller('store/banners')
@UseGuards(StoreGuard)
export class BannerStoreController {
  @Get()
  async findActive(@Request() req): Promise<BannerResponseDto[]> {
    const { customerId } = req.user;
    return this.bannerService.findActive(customerId);
  }
}
```

### Environment Variable
The `@yomcl/jwt-verify` package requires `TOKEN_PACKAGE` to be set in the environment. Always include it in `.env.example`:

```env
TOKEN_PACKAGE=your_github_packages_token
```

