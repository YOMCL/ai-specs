## Domain-Driven Design Principles

### Entities

Entities have identity and encapsulate business behavior:

```typescript
// Good: Entity with behavior, validates invariants in constructor
export class Banner {
  private constructor(
    public readonly id: BannerId,
    private title: string,
    private status: BannerStatus,
    private readonly customerId: string,
  ) {}

  static create(props: CreateBannerProps): Banner {
    if (!props.customerId) {
      throw new MissingCustomerIdError();
    }
    return new Banner(
      BannerId.generate(),
      props.title,
      BannerStatus.ACTIVE,
      props.customerId,
    );
  }

  deactivate(): void {
    if (this.status === BannerStatus.INACTIVE) {
      throw new BannerAlreadyInactiveError(this.id);
    }
    this.status = BannerStatus.INACTIVE;
  }

  isActive(): boolean {
    return this.status === BannerStatus.ACTIVE;
  }
}

// Bad: Anemic entity — just a data bag with no behavior
export class Banner {
  id: string;
  title: string;
  status: string;
  customerId: string;
}
```

### Value Objects

Immutable, validated at construction time:

```typescript
export class BannerId {
  private constructor(private readonly value: string) {}

  static generate(): BannerId {
    return new BannerId(new Types.ObjectId().toHexString());
  }

  static from(raw: string): BannerId {
    if (!raw || !Types.ObjectId.isValid(raw)) {
      throw new InvalidBannerIdError(raw);
    }
    return new BannerId(raw);
  }

  getValue(): string {
    return this.value;
  }

  equals(other: BannerId): boolean {
    return this.value === other.value;
  }
}
```

### Repository Interfaces (Ports)

Define interfaces in the domain layer — implementations go in infrastructure:

```typescript
// domain/repositories/banner.repository.interface.ts
export interface IBannerRepository {
  findById(id: BannerId, customerId: string): Promise<Banner | null>;
  findAll(customerId: string): Promise<Banner[]>;
  save(banner: Banner): Promise<void>;
  delete(id: BannerId, customerId: string): Promise<void>;
}

// Register with a symbol token for NestJS injection:
export const BANNER_REPOSITORY = Symbol('IBannerRepository');
```

### Domain Events

Use domain events for side effects that cross aggregate boundaries:

```typescript
export class BannerDeactivatedEvent {
  constructor(
    public readonly bannerId: BannerId,
    public readonly customerId: string,
    public readonly deactivatedAt: Date,
  ) {}
}
```

