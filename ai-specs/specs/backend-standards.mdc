## Database Patterns

### MongoDB + Mongoose (NestJS)

```typescript
// Schema definition with decorators — always include customerId with an index
@Schema({ timestamps: true, collection: 'banners' })
export class BannerDocument {
  @Prop({ required: true, index: true })
  customerId: string;

  @Prop({ required: true, trim: true, maxlength: 200 })
  title: string;

  @Prop({ required: true, enum: ['active', 'inactive'], default: 'active' })
  status: string;
}

export const BannerSchema = SchemaFactory.createForClass(BannerDocument);
BannerSchema.index({ customerId: 1, createdAt: -1 });
BannerSchema.index({ customerId: 1, status: 1 });
```

```typescript
// Repository implementation — always include customerId in every query
@Injectable()
export class MongoBannerRepository implements IBannerRepository {
  constructor(
    @InjectModel(BannerDocument.name)
    private readonly model: Model<BannerDocument>,
  ) {}

  async findById(id: BannerId, customerId: string): Promise<Banner | null> {
    const doc = await this.model
      .findOne({ _id: id.getValue(), customerId })
      .lean()
      .exec();
    return doc ? BannerMapper.toDomain(doc) : null;
  }

  async findAll(customerId: string): Promise<Banner[]> {
    const docs = await this.model
      .find({ customerId })
      .lean()
      .exec();
    return docs.map(BannerMapper.toDomain);
  }

  async save(banner: Banner): Promise<void> {
    const doc = BannerMapper.toPersistence(banner);
    await this.model
      .findByIdAndUpdate(doc._id, doc, { upsert: true, new: true })
      .exec();
  }

  async delete(id: BannerId, customerId: string): Promise<void> {
    await this.model.findOneAndDelete({ _id: id.getValue(), customerId }).exec();
  }
}
```

### Mongoose Best Practices
- Always include `customerId` in every query — no exceptions
- Always define indexes in the schema definition (never in separate migration files)
- Use `.lean()` for read-only queries — returns plain JS objects, not Mongoose documents
- Use `findByIdAndUpdate` with `upsert: true` for save/create operations
- Use `populate()` only when you need related documents in the response; avoid for performance-critical paths
- Handle Mongoose errors: `CastError` → 400, `MongoServerError` code 11000 (unique violation) → 409

### PostgreSQL + Prisma (products service)

```typescript
@Injectable()
export class PrismaFAQRepository implements IFAQRepository {
  constructor(private readonly prisma: PrismaService) {}

  async findById(id: string, customerId: string): Promise<FAQ | null> {
    const record = await this.prisma.fAQ.findFirst({
      where: { id, customerId },
    });
    return record ? FAQMapper.toDomain(record) : null;
  }

  async findAll(customerId: string): Promise<FAQ[]> {
    const records = await this.prisma.fAQ.findMany({
      where: { customerId },
      orderBy: { createdAt: 'desc' },
    });
    return records.map(FAQMapper.toDomain);
  }
}
```

